## AddonCompartmentFunc: PvPTally_OnAddonCompartmentClick

# Self-contained: no dependencies on other addons. Spy's saved data is only read, when
# it happens to be loaded, to offer a one-time import.

# Texts: English first (it creates ns.L), then each language overwrites what it translates.
Locales\enUS.lua
Locales\deDE.lua
Locales\esES.lua
Locales\frFR.lua
Locales\itIT.lua
Locales\koKR.lua
Locales\ptBR.lua
Locales\ruRU.lua
Locales\zhCN.lua
Locales\zhTW.lua

# Core: pure logic, no game API calls.
Core\Util.lua
Core\Events.lua
Core\Settings.lua
Core\Store.lua
Core\Races.lua

# Game: the only layer that reads the WoW API, and the kill / death detection.
Game\WowApi.lua
Game\Tracker.lua

# Features built on the core.
Features\SpyImport.lua
Features\TestData.lua
Features\Notifications.lua

# User interface.
UI\Columns.lua
UI\ListModel.lua
UI\Rows.lua
UI\Window.lua
UI\MinimapButton.lua
UI\SettingsPanel.lua

Commands.lua
Init.lua
